{
	"name": "portfolio",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"build": "astro build",
		"dev": "astro dev --ignore-lock",
		"preview": "varlock-wrangler dev",
		"resume": "node resume/build.ts",
		"deploy": "astro build && varlock-wrangler deploy",
		"check": "vp check && prettier --check \"**/*.astro\" && eslint && astro check",
		"test": "vp test run --passWithNoTests",
		"test:unit": "vp test run --project unit --passWithNoTests",
		"test:server": "vp test run --project server --passWithNoTests",
		"test:integration": "playwright test",
		"test:browser": "vp test run --project browser",
		"test:update": "vp test run --project browser --update && playwright test e2e/visual.spec.ts --update-snapshots",
		"test:watch": "vp test --watch",
		"test:ui": "vp test dev --ui --open=false --project browser --api.port ${APP_PORT:-5123} --api.strictPort",
		"e2e": "playwright test",
		"e2e:domains": "CHECK_DOMAINS=1 BASE_URL=https://www.ariaamini.dev varlock run -- playwright test e2e/domains.spec.ts",
		"e2e:update": "playwright test --update-snapshots",
		"report": "playwright show-report .playwright/report",
		"fmt": "vp fmt && prettier --write \"**/*.astro\""
	},
	"dependencies": {
		"@astrojs/cloudflare": "^14.3.4",
		"@astrojs/react": "^7.0.1",
		"@astrojs/sitemap": "^3.7.4",
		"@base-ui/react": "^1.8.0",
		"@fontsource-variable/bricolage-grotesque": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@phosphor-icons/react": "^2.1.10",
		"@tailwindcss/vite": "4.3.3",
		"@varlock/astro-integration": "^1.4.3",
		"@varlock/cloudflare-integration": "^1.6.2",
		"astro": "^7.3.8",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.4.0",
		"posthog-js": "^1.391.2",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"sharp": "^0.35.5",
		"tailwindcss": "4.3.3",
		"varlock": "^1.22.0"
	},
	"devDependencies": {
		"@aamini/config": "0.2.0",
		"@astrojs/check": "^0.9.10",
		"@myriaddreamin/typst-ts-node-compiler": "^0.7.0",
		"@oxlint/plugins": "1.83.0",
		"@playwright/test": "^1.64.0",
		"@shadcn/lint": "^0.2.1",
		"@types/node": "^24.19.2",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@typescript-eslint/parser": "^8.71.2",
		"@vitejs/plugin-react": "^6.0.2",
		"@vitest/browser-playwright": "5.0.3",
		"@vitest/ui": "5.0.3",
		"astro-eslint-parser": "^3.2.0",
		"eslint": "^10.12.0",
		"fallow": "^3.32.0",
		"oxc-transform-react": "^0.145.0",
		"oxlint-plugin-eslint": "^1.73.0",
		"prettier": "3.9.10",
		"prettier-plugin-astro": "1.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"shadcn": "^4.21.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite-plus": "1.1.0",
		"vitest": "5.0.3",
		"wrangler": "^4.151.0"
	},
	"packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec"
}
