{
	"name": "portfolio",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"build": "vp build",
		"dev": "vp dev",
		"preview": "vp preview",
		"start": "varlock run -- node .output/server/index.mjs",
		"check": "vp check",
		"test": "vp test run --passWithNoTests",
		"test:unit": "vp test run --project unit --passWithNoTests",
		"test:server": "vp test run --project server --passWithNoTests",
		"test:integration": "vp test run --project browser --project server",
		"test:browser": "vp test run --project browser",
		"test:update": "vp test run --project browser --update",
		"test:watch": "vp test --watch",
		"test:ui": "vp test dev --ui --open=false --project browser --api.port ${APP_PORT:-5123} --api.strictPort",
		"e2e": "varlock run -- playwright test",
		"report": "playwright show-report .playwright/report",
		"prepare": "vp config --no-hooks"
	},
	"dependencies": {
		"@fontsource-variable/dm-sans": "^5.2.8",
		"@hookform/resolvers": "^5.2.2",
		"@radix-ui/react-accordion": "^1.2.12",
		"@radix-ui/react-collapsible": "^1.1.12",
		"@radix-ui/react-label": "^2.1.8",
		"@radix-ui/react-navigation-menu": "^1.2.14",
		"@radix-ui/react-slot": "^1.2.4",
		"@tanstack/react-query": "5.101.0",
		"@tanstack/react-router": "1.170.18",
		"@tanstack/react-start": "1.168.32",
		"@tanstack/router-core": "1.171.15",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"form-data": "^4.0.5",
		"lucide-react": "^1.8.0",
		"mailgun.js": "^13.0.0",
		"nitro": "3.0.260610-beta",
		"posthog-js": "^1.391.2",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"react-hook-form": "^7.71.2",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.5.0",
		"varlock": "^1.14.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@rolldown/plugin-babel": "^0.2.3",
		"@tailwindcss/vite": "^4.3.1",
		"@tanstack/devtools-vite": "0.8.0",
		"@types/node": "^26.1.1",
		"@types/react": "19.2.17",
		"@types/react-dom": "^19.2.3",
		"@varlock/vite-integration": "^1.4.0",
		"@vitejs/plugin-react": "^6.0.2",
		"@vitest/browser-playwright": "4.1.11",
		"@vitest/ui": "4.1.11",
		"babel-plugin-react-compiler": "^1.0.0",
		"@playwright/test": "^1.61.0",
		"tailwindcss": "^4.3.1",
		"tw-animate-css": "^1.4.0",
		"typescript": "6.0.3",
		"vite": "catalog:",
		"vite-plugin-svgr": "^5.2.0",
		"vite-plus": "catalog:",
		"vitest": "catalog:",
		"vitest-browser-react": "^2.2.0"
	},
	"packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec"
}
