---
import Hero from '@/components/hero.astro'
import SelectedWork from '@/components/selected-work.astro'
import { SiteDialogs } from '@/components/site-dialogs'
import SiteHeader from '@/components/site-header.astro'
import { Separator } from '@/components/ui/separator'
import Base from '@/layouts/base.astro'
import { readDialog } from '@/lib/dialog-url'

const dialog = readDialog(Astro.url)
---

<Base>
	<div class="flex-1">
		<a
			href="#main"
			class="bg-card text-foreground focus-visible:ring-ring fixed top-3 left-6 z-50 -translate-y-24 rounded-lg border px-4 py-3 font-semibold focus:translate-y-0 focus-visible:ring-3"
		>
			Skip to content
		</a>
		<SiteHeader />
		<main id="main" tabindex="-1" class="mx-auto w-full max-w-5xl px-6 pb-20">
			<Hero />
			<Separator />
			<SelectedWork />
		</main>
		<SiteDialogs client:load open={dialog} />
	</div>
</Base>
